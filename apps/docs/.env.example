# Environment Variables for Assistant UI Docs

# OpenAI API Key - Required for chat functionality
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Vercel KV (Optional - only needed for rate limiting)
# Get from: https://vercel.com/dashboard/stores
# 1. Click "Upstash" → "Redis"
# 2. Create a Redis database
# 3. Copy the credentials below
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your-token-here

# Note: Rate limiting is optional for local development.
# The app will work fine without these KV variables.
